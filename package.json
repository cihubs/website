{
  "name": "astroplate",
  "version": "5.12.1",
  "description": "Astro and Tailwindcss boilerplate",
  "author": "zeon.studio",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "better-sqlite3",
      "esbuild",
      "@tailwindcss/oxide"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "dev:local": "concurrently \"node scripts/themeGenerator.js --watch\" \"pnpm generate-json && astro dev\"",
    "build": "node scripts/themeGenerator.js && pnpm generate-json && astro build && node scripts/fixPagesBase.js",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier -w ./src",
    "generate-json": "node scripts/jsonGenerator.js",
    "remove-darkmode": "node scripts/removeDarkmode.js && pnpm format"
  },
  "dependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/mdx": "4.3.13",
    "@astrojs/sitemap": "3.7.0",
    "@builder.io/qwik": "^1.20.1",
    "@digi4care/astro-google-tagmanager": "^1.6.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@qwikdev/astro": "^0.8.3",
    "@tinacms/cli": "^2.1.7",
    "astro": "5.17.3",
    "astro-auto-import": "^0.5.1",
    "astro-font": "^1.1.0",
    "astro-swiper": "^2.1.0",
    "date-fns": "^4.1.0",
    "flowbite": "^4.0.2",
    "flowbite-qwik": "^1.1.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.3",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "sharp": "^0.34.5",
    "tinacms": "^3.5.1",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "25.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "style-dictionary": "^4.4.0",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
