---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";
---

<Base
  title="Programas"
  meta_title="Programas - CIHUBS"
  description="Conozca nuestros programas de innovación y desarrollo tecnológico"
>
  <PageHeader title="Programas" />
  <section class="section-sm">
    <div class="container">
      <div class="row justify-center">
        <div class="md:col-10 lg:col-8">
          <p class="text-lg text-gray-700 mb-8" style={{ fontFamily: 'Montserrat, sans-serif', fontWeight: 400, lineHeight: '1.6' }}>
            CIHUBS ofrece una variedad de programas diseñados para impulsar la innovación, el desarrollo tecnológico y el crecimiento económico en la región.
          </p>
          
          <div class="space-y-6">
            <a
              href="/programas/soft-landing-de-conocimiento-e-innovacion"
              class="block p-6 bg-white rounded-lg shadow-sm border border-gray-200 hover:border-[#203370] transition-colors"
            >
              <h3 class="text-2xl font-bold text-[#203370] mb-2" style={{ fontFamily: 'Poppins, sans-serif', fontWeight: 700 }}>
                Soft Landing de Conocimiento e Innovación
              </h3>
              <p class="text-gray-600" style={{ fontFamily: 'Montserrat, sans-serif', fontWeight: 400 }}>
                Programa de aterrizaje suave para organizaciones de conocimiento e innovación
              </p>
            </a>

            <a
              href="/programas/programas-discovery"
              class="block p-6 bg-white rounded-lg shadow-sm border border-gray-200 hover:border-[#203370] transition-colors"
            >
              <h3 class="text-2xl font-bold text-[#203370] mb-2" style={{ fontFamily: 'Poppins, sans-serif', fontWeight: 700 }}>
                Programas Discovery
              </h3>
              <p class="text-gray-600" style={{ fontFamily: 'Montserrat, sans-serif', fontWeight: 400 }}>
                Programas de descubrimiento y exploración de oportunidades
              </p>
            </a>

            <a
              href="/programas/programas-inmersion"
              class="block p-6 bg-white rounded-lg shadow-sm border border-gray-200 hover:border-[#203370] transition-colors"
            >
              <h3 class="text-2xl font-bold text-[#203370] mb-2" style={{ fontFamily: 'Poppins, sans-serif', fontWeight: 700 }}>
                Programas Inmersión
              </h3>
              <p class="text-gray-600" style={{ fontFamily: 'Montserrat, sans-serif', fontWeight: 400 }}>
                Programas de inmersión profunda en ecosistemas de innovación
              </p>
            </a>

            <a
              href="/programas/potenciar-zonas-francas-a-high-tech"
              class="block p-6 bg-white rounded-lg shadow-sm border border-gray-200 hover:border-[#203370] transition-colors"
            >
              <h3 class="text-2xl font-bold text-[#203370] mb-2" style={{ fontFamily: 'Poppins, sans-serif', fontWeight: 700 }}>
                Potenciar Zonas Francas a High-Tech
              </h3>
              <p class="text-gray-600" style={{ fontFamily: 'Montserrat, sans-serif', fontWeight: 400 }}>
                Transformación de zonas francas en centros de alta tecnología
              </p>
            </a>

            <a
              href="/programas/encadenamientos-globales"
              class="block p-6 bg-white rounded-lg shadow-sm border border-gray-200 hover:border-[#203370] transition-colors"
            >
              <h3 class="text-2xl font-bold text-[#203370] mb-2" style={{ fontFamily: 'Poppins, sans-serif', fontWeight: 700 }}>
                Encadenamientos Globales
              </h3>
              <p class="text-gray-600" style={{ fontFamily: 'Montserrat, sans-serif', fontWeight: 400 }}>
                Conexión con cadenas globales de valor y conocimiento
              </p>
            </a>

            <a
              href="/programas/ciudades-cientificas-y-tecnologicas"
              class="block p-6 bg-white rounded-lg shadow-sm border border-gray-200 hover:border-[#203370] transition-colors"
            >
              <h3 class="text-2xl font-bold text-[#203370] mb-2" style={{ fontFamily: 'Poppins, sans-serif', fontWeight: 700 }}>
                Ciudades Científicas y Tecnológicas
              </h3>
              <p class="text-gray-600" style={{ fontFamily: 'Montserrat, sans-serif', fontWeight: 400 }}>
                Desarrollo de ciudades científicas y tecnológicas
              </p>
            </a>

            <a
              href="/programas/brazo-comercial-de-generadores-de-conocimiento"
              class="block p-6 bg-white rounded-lg shadow-sm border border-gray-200 hover:border-[#203370] transition-colors"
            >
              <h3 class="text-2xl font-bold text-[#203370] mb-2" style={{ fontFamily: 'Poppins, sans-serif', fontWeight: 700 }}>
                Brazo Comercial de Generadores de Conocimiento
              </h3>
              <p class="text-gray-600" style={{ fontFamily: 'Montserrat, sans-serif', fontWeight: 400 }}>
                Comercialización de conocimientos y tecnologías generadas
              </p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
