---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";

const contactIndex = await getListPage("contact", "-index");

if (contactIndex.data.draft) {
  return Astro.redirect("/404");
}

const title = "Contáctenos";
const description =
  "Envíenos un mensaje o llámenos. Nos encanta saber de usted y estaremos encantados de responder cualquier pregunta.";
---

<Base title={title} description={description}>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto mb-12 text-center md:col-10 lg:col-8">
          <p class="text-lg">{description}</p>
        </div>
      </div>
      <div class="row mb-12 text-center">
        <div class="mb-8 md:col-4">
          <h2 class="h5 mb-3">NUESTRA OFICINA</h2>
          <p>
            Casa 20 Barrio Tena, San Rafael de Escazú,<br />
            San José, Costa Rica
          </p>
        </div>
        <div class="mb-8 md:col-4">
          <h2 class="h5 mb-3">NUESTRO CORREO</h2>
          <p>
            <a href="mailto:juanignacio@cihubs.com">juanignacio@cihubs.com</a>
          </p>
        </div>
        <div class="mb-8 md:col-4">
          <h2 class="h5 mb-3">NUESTRO TELÉFONO</h2>
          <p>
            <a href="tel:+50684155247">+506 8415-5247</a>
          </p>
        </div>
      </div>
      <div class="row">
        <div class="mx-auto md:col-10 lg:col-6">
          <form id="contact-form">
            <div class="mb-6">
              <label for="name" class="form-label">
                Nombre <span class="text-red-500">*</span>
              </label>
              <input
                id="name"
                name="name"
                class="form-input"
                placeholder="Nombre"
                type="text"
                required
              />
            </div>
            <div class="mb-6">
              <label for="email" class="form-label">
                Correo <span class="text-red-500">*</span>
              </label>
              <input
                id="email"
                name="email"
                class="form-input"
                placeholder="Correo"
                type="email"
                required
              />
            </div>
            <div class="mb-6">
              <label for="quien-soy" class="form-label">
                ¿Quién soy? <span class="text-red-500">*</span>
              </label>
              <select
                id="quien-soy"
                name="quien-soy"
                class="form-input"
                required
              >
                <option value="">¿Quién Soy? (seleccione una opción)</option>
                <option value="Startups y Pymes">Startups y Pymes</option>
                <option value="Zonas Francas y sus empresas">
                  Zonas Francas y sus empresas
                </option>
                <option value="ONGs y actores de la Sociedad Civil">
                  ONGs y actores de la Sociedad Civil
                </option>
                <option value="Universidades y Centros de Investigación y Desarrollo">
                  Universidades y Centros de Investigación y Desarrollo
                </option>
                <option value="Gobiernos Locales">Gobiernos Locales</option>
              </select>
            </div>
            <div class="mb-6">
              <label for="message" class="form-label">
                Mensaje <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                class="form-input"
                placeholder="Mensaje"
                required
                rows="8"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Enviar</button>
          </form>
          <p class="mt-6">
            O escríbanos directamente a{" "}
            <a href="mailto:juanignacio@cihubs.com">juanignacio@cihubs.com</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const quienSoy = String(data.get("quien-soy") ?? "").trim();
    const message = String(data.get("message") ?? "").trim();
    const subject = encodeURIComponent(`Contacto web: ${name} (${quienSoy})`);
    const body = encodeURIComponent(
      `Nombre: ${name}\nCorreo: ${email}\n¿Quién soy?: ${quienSoy}\n\n${message}`
    );
    window.location.href = `mailto:juanignacio@cihubs.com?subject=${subject}&body=${body}`;
  });
</script>
