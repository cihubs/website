---
import ImageMod from "@/components/ImageMod.astro";
import Icon from "@/helpers/Icon.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { withBase } from "@/lib/utils/withBase";
import CallToAction from "@/partials/CallToAction.astro";
import Testimonial from "@/partials/Testimonial.astro";

const homepage = await getListPage("homepage", "-index");
const call_to_action = await getListPage("ctaSection", "call-to-action");
const testimonial = await getListPage("testimonialSection", "testimonial");

const { banner, features } = homepage.data;
---

<Base>
  <!-- Banner -->
  <section
    class="section parallax relative pt-14"
    style={`background-image: url(${withBase("/images/cihubs-space.jpg")})`}
  >
    <div class="absolute inset-0 bg-[#203370]/70"></div>
    <div class="container relative">
      <div class="row justify-center">
        <div class="lg:col-7 md:col-9 mb-8 text-center">
          <h1
            data-anim
            set:html={markdownify(banner.title)}
            class="mb-4 text-h3 text-white lg:text-h1"
          />
          <p data-anim set:html={markdownify(banner.content)} class="mb-8 text-white" />
          {
            banner.button.enable && (
              <a
                data-anim
                class="btn btn-primary"
                href={banner.button.link}
                target={
                  banner.button.link.startsWith("http") ? "_blank" : "_self"
                }
                rel="noopener"
              >
                {banner.button.label}
              </a>
            )
          }
        </div>
        {
          banner.image && (
            <div class="col-12">
              <ImageMod
                src={banner.image}
                height={380}
                width={1200}
                alt="banner"
                format="webp"
              />
            </div>
          )
        }
      </div>
    </div>
  </section>
  <!-- /Banner -->

  <!-- Features -->
  {
    features.map((feature, index: number) => (
      <section class={`section-sm ${index % 2 === 0 && "bg-gradient"}`}>
        <div class="container">
          <div class="row items-center justify-between">
            <div
              class={`mb:md-0 mb-6 md:col-5 ${index % 2 !== 0 && "md:order-2"}`}
            >
              <ImageMod
                src={feature.image}
                height={480}
                width={520}
                alt={feature.title}
                format="webp"
              />
            </div>
            <div class={`md:col-7 lg:col-6 ${index % 2 !== 0 && "md:order-1"}`}>
              <h2 data-anim set:html={markdownify(feature.title)} class="mb-4" />
              <p set:html={markdownify(feature.content)} class="mb-8 text-lg" />
              <ul>
                {feature.bulletpoints.map((bullet: string) => (
                  <li class="relative mb-4 pl-6">
                    <Icon name="check" className="absolute left-0 top-1.5" />
                    <span set:html={markdownify(bullet)} />
                  </li>
                ))}
              </ul>
              {feature.button.enable && (
                <a class="btn btn-primary mt-5" href={feature.button.link}>
                  {feature.button.label}
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }
  <!-- /Features -->

  <Testimonial testimonial={testimonial} />

  <!-- Mission -->
  <section id="our-mission" class="section bg-gradient">
    <div class="container">
      <div class="row">
        <div class="mx-auto mb-12 text-center md:col-10 lg:col-8">
          <h2 data-anim class="mb-4">
            <strong>CIHubs</strong> es el mejor socio estratégico para dinamizar
            ecosistemas de innovación
          </h2>
        </div>
      </div>
      <div class="row">
        <div class="mb-6 md:col-6 lg:col-3">
          <div class="rounded-lg bg-body px-7 py-10 text-center dark:bg-darkmode-body">
            <h3 class="h5 mb-3">
              Transformamos zonas francas en Parques Científicos y Tecnológicos
            </h3>
          </div>
        </div>
        <div class="mb-6 md:col-6 lg:col-3">
          <div class="rounded-lg bg-body px-7 py-10 text-center dark:bg-darkmode-body">
            <h3 class="h5 mb-3">
              Incorporamos cadenas de valor locales a cadenas de valor globales
            </h3>
          </div>
        </div>
        <div class="mb-6 md:col-6 lg:col-3">
          <div class="rounded-lg bg-body px-7 py-10 text-center dark:bg-darkmode-body">
            <h3 class="h5 mb-3">
              Apoyamos la creación de ciudades científicas y tecnológicas en
              gobiernos locales
            </h3>
          </div>
        </div>
        <div class="mb-6 md:col-6 lg:col-3">
          <div class="rounded-lg bg-body px-7 py-10 text-center dark:bg-darkmode-body">
            <h3 class="h5 mb-3">
              Implementamos plataformas de comercialización para entidades
              académicas y de investigación y desarrollo
            </h3>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /Mission -->

  <!-- Clients -->
  <section id="clientes" class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto mb-12 text-center md:col-10 lg:col-8">
          <h2 data-anim class="mb-4">Clientes</h2>
        </div>
        <div class="col-12">
          <div class="row items-center justify-center">
            {
              [
                "micitt.png",
                "tlo.png",
                "tampere.png",
                "saab.png",
                "pluganplay.png",
                "parquetec.png",
                "cambridge.png",
                "onevalley.png",
                "establishmentlabs.png",
                "madrid.png",
                "cendana.png",
                "cenat.png",
                "wow.jpg",
                "warkick.jpg",
                "ucr.jpg",
                "cinde.jpg",
                "gaiker-1.jpg",
                "crusa.jpg",
                "azofras.jpg",
                "rocket.jpg",
                "tecnalia.jpg",
                "coyol.jpg",
                "singularity.jpg",
              ].map((logo) => (
                <div class="col-6 mb-8 text-center sm:col-4 lg:col-3">
                  <img
                    loading="lazy"
                    decoding="async"
                    width="250"
                    height="100"
                    src={withBase(`/images/clients/${logo}`)}
                    alt={logo.replace(/\.(png|jpg)$/, "")}
                    class="mx-auto"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /Clients -->

  <CallToAction call_to_action={call_to_action} />
</Base>
