---
import ImageMod from "@/components/ImageMod.astro";
import Icon from "@/helpers/Icon.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { withBase } from "@/lib/utils/withBase";
import CallToAction from "@/partials/CallToAction.astro";
import Testimonial from "@/partials/Testimonial.astro";

const homepage = await getListPage("homepage", "-index");
const call_to_action = await getListPage("ctaSection", "call-to-action");
const testimonial = await getListPage("testimonialSection", "testimonial");

const { banner, features } = homepage.data;

// Flowbite-style outline icons for the "Recibimos/Atraemos/Damos Valor" cards
const valorIcons = [
  '<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 5 8a7 7 0 0 1 14 0Z"/>',
  '<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-4a3 3 0 0 0-3 3Zm8-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>',
  '<rect x="2.5" y="6" width="19" height="12" rx="2" stroke="currentColor" stroke-width="2"/><text x="12" y="15.5" text-anchor="middle" font-size="9" font-weight="700" fill="currentColor" font-family="Montserrat, sans-serif">$</text>',
];
---

<Base>
  <!-- Banner -->
  <section
    class="section parallax relative flex min-h-[82vh] items-center pt-14"
    style={`background-image: url(${withBase("/images/hero-home.jpg")})`}
  >
    <div class="absolute inset-0 bg-gradient-to-r from-[#0a1a33]/90 via-[#0a1a33]/45 to-transparent"></div>
    <div class="container relative">
      <div class="row justify-start">
        <div class="lg:col-7 md:col-9 mb-8">
          <h1
            data-anim
            set:html={markdownify(banner.title)}
            class="mb-4 font-bold text-white text-[clamp(2.75rem,6vw,4.375rem)] leading-[1.05]"
            style="font-family: 'Poppins', sans-serif; font-weight: 700;"
          />
          <p data-anim set:html={markdownify(banner.content)} class="mb-8 text-white/90 text-xl md:text-2xl font-normal" style="font-family: 'Montserrat', sans-serif; font-weight: 400;" />
          {
            banner.button.enable && (
              <a
                data-anim
                class="rounded-full bg-white px-8 py-3 text-sm font-bold uppercase tracking-widest text-[#203370] transition hover:bg-gray-100"
                style="font-family: 'Montserrat', sans-serif; font-weight: 700;"
                href={banner.button.link}
                target={
                  banner.button.link.startsWith("http") ? "_blank" : "_self"
                }
                rel="noopener"
              >
                {banner.button.label}
              </a>
            )
          }
        </div>
        {
          banner.image && (
            <div class="col-12">
              <ImageMod
                src={banner.image}
                height={380}
                width={1200}
                alt="banner"
                format="webp"
              />
            </div>
          )
        }
      </div>
    </div>
    <a
      href="#servicios"
      aria-label="Ver más"
      class="absolute bottom-6 left-1/2 flex h-12 w-12 -translate-x-1/2 items-center justify-center rounded-full border border-white/70 text-white transition hover:bg-white hover:text-[#203370]"
    >
      <svg class="h-5 w-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19V5m0 14-6-6m6 6 6-6" />
      </svg>
    </a>
  </section>
  <!-- /Banner -->

  <!-- Features -->
  {
    features.map((feature, index: number) => (
      <section id={index === 0 ? "servicios" : undefined} class={`section-sm relative overflow-hidden ${index % 2 === 0 && "bg-gradient"}`}>
        {index === 0 && (
          <img
            src={withBase("/images/cihubs-space.jpg")}
            alt=""
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-10 select-none"
          />
        )}
        <div class="container relative">
          <div class="row items-center justify-between">
            <div
              class={`mb:md-0 mb-6 md:col-5 ${index % 2 !== 0 && "md:order-2"}`}
            >
              <ImageMod
                src={feature.image}
                height={480}
                width={520}
                alt={feature.title}
                format="webp"
                class="img-neon"
              />
            </div>
            <div class={`md:col-7 lg:col-6 ${index % 2 !== 0 && "md:order-1"}`}>
              <h2 data-anim set:html={markdownify(feature.title)} class="mb-4" />
              <p set:html={markdownify(feature.content)} class="mb-8 text-lg" />
              {index === 0 && (
                <div class="mb-8 flex flex-col gap-4">
                  {feature.bulletpoints.map((bullet: string, i: number) => (
                    <div class="flex items-center gap-4 rounded-2xl bg-white px-5 py-4 shadow-xl">
                      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[#203370] text-white shadow-lg">
                        <svg class="h-7 w-7" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" set:html={valorIcons[i]} />
                      </div>
                      <p set:html={markdownify(bullet)} class="text-sm font-medium text-[#203370]" style="font-family: 'Montserrat', sans-serif;" />
                    </div>
                  ))}
                </div>
              )}
              {index !== 0 && (
                <ul>
                  {feature.bulletpoints.map((bullet: string) => (
                    <li class="relative mb-4 pl-6">
                      <Icon name="check" className="absolute left-0 top-1.5" />
                      <span set:html={markdownify(bullet)} />
                    </li>
                  ))}
                </ul>
              )}
              {feature.button.enable && (
                <a class="btn btn-primary mt-5" href={feature.button.link}>
                  {feature.button.label}
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }
  <!-- /Features -->

  {/* <Testimonial testimonial={testimonial} /> testimonios ocultos temporalmente */}
  <!-- /Testimonial (hidden) -->

  <!-- Mission -->
  <section id="our-mission" class="section bg-gradient">
    <div class="container">
      <div class="row">
        <div class="mx-auto mb-12 text-center md:col-10 lg:col-8">
          <h2 data-anim class="mb-4">
            <strong>CIHubs</strong> es el mejor socio estratégico para dinamizar
            ecosistemas de innovación
          </h2>
        </div>
      </div>
      <div class="row">
        <div class="mx-auto mb-12 text-center md:col-10">
          <ImageMod
            src="/images/banner.png"
            height={380}
            width={1200}
            alt="Astronauta CIHubs"
            format="webp"
          />
        </div>
      </div>
      <div class="row">
        <div class="mb-6 md:col-6 lg:col-3">
          <div class="rounded-lg bg-body px-7 py-10 text-center dark:bg-darkmode-body">
            <h3 class="h5 mb-3">
              Transformamos zonas francas en Parques Científicos y Tecnológicos
            </h3>
          </div>
        </div>
        <div class="mb-6 md:col-6 lg:col-3">
          <div class="rounded-lg bg-body px-7 py-10 text-center dark:bg-darkmode-body">
            <h3 class="h5 mb-3">
              Incorporamos cadenas de valor locales a cadenas de valor globales
            </h3>
          </div>
        </div>
        <div class="mb-6 md:col-6 lg:col-3">
          <div class="rounded-lg bg-body px-7 py-10 text-center dark:bg-darkmode-body">
            <h3 class="h5 mb-3">
              Apoyamos la creación de ciudades científicas y tecnológicas en
              gobiernos locales
            </h3>
          </div>
        </div>
        <div class="mb-6 md:col-6 lg:col-3">
          <div class="rounded-lg bg-body px-7 py-10 text-center dark:bg-darkmode-body">
            <h3 class="h5 mb-3">
              Implementamos plataformas de comercialización para entidades
              académicas y de investigación y desarrollo
            </h3>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /Mission -->

  <!-- Aliados -->
  <section id="aliados" class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto mb-12 text-center md:col-10 lg:col-8">
          <h2 data-anim class="mb-4">Aliados</h2>
        </div>
        <div class="col-12">
          <div class="row items-center justify-center">
            {
              [
                "micitt.png",
                "tlo.png",
                "tampere.png",
                "saab.png",
                "pluganplay.png",
                "parquetec.png",
                "cambridge.png",
                "onevalley.png",
                "establishmentlabs.png",
                "madrid.png",
                "cendana.png",
                "cenat.png",
                "wow.jpg",
                "warkick.jpg",
                "ucr.jpg",
                "cinde.jpg",
                "gaiker-1.jpg",
                "crusa.jpg",
                "azofras.jpg",
                "rocket.jpg",
                "tecnalia.jpg",
                "coyol.jpg",
                "singularity.jpg",
              ].map((logo) => (
                <div class="col-6 mb-8 text-center sm:col-4 lg:col-3">
                  <div class="logo-card mx-auto rounded-2xl bg-white p-4">
                    <img
                      loading="lazy"
                      decoding="async"
                      width="250"
                      height="100"
                      src={withBase(`/images/clients/${logo}`)}
                      alt={logo.replace(/\.(png|jpg)$/, "")}
                      class="mx-auto rounded-xl"
                    />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /Aliados -->

  <CallToAction call_to_action={call_to_action} />
</Base>
