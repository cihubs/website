---
interface Props {
  title: string;
  width?: number | string;
  height?: number | string;
  src: string;
}

const { title, width = 500, height = "auto", src } = Astro.props;
---

<video
  class="overflow-hidden rounded-lg"
  width={width}
  height={height}
  controls
>
  <source src={src.match(/^http/) ? src : `/videos/${src}`} type="video/mp4" />
  {title}
</video>
