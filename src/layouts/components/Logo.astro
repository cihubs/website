---
import config from "@/config/config.json";
import { withBase } from "@/lib/utils/withBase";
import ImageMod from "./ImageMod.astro";

const { src, srcDarkmode }: { src?: string; srcDarkmode?: string } =
  Astro.props;
const {
  logo,
  logo_darkmode,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_darkmode: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;

const { theme_switcher }: { theme_switcher: boolean } = config.settings;
---

<a href={withBase("/")} class="navbar-brand inline-block">
  {
    src || srcDarkmode || logo || logo_darkmode ? (
      <>
        {(src ? src : logo).endsWith(".svg") ? (
          <img
            src={src ? src : logo}
            class={`logo-light inline-block ${theme_switcher && "dark:hidden"}`}
            width={logo_width.replace("px", "") * 2}
            height={logo_height.replace("px", "") * 2}
            alt={title}
            style={{
              height: logo_height.replace("px", "") + "px",
              width: logo_width.replace("px", "") + "px",
            }}
          />
        ) : (
          <ImageMod
            src={src ? src : logo}
            class={`logo-light inline-block ${theme_switcher && "dark:hidden"}`}
            width={logo_width.replace("px", "") * 2}
            height={logo_height.replace("px", "") * 2}
            alt={title}
            style={{
              height: logo_height.replace("px", "") + "px",
              width: logo_width.replace("px", "") + "px",
            }}
            format="webp"
          />
        )}
        {theme_switcher && (
          (srcDarkmode ? srcDarkmode : logo_darkmode).endsWith(".svg") ? (
            <img
              src={srcDarkmode ? srcDarkmode : logo_darkmode}
              class={"logo-dark hidden dark:inline-block"}
              width={logo_width.replace("px", "") * 2}
              height={logo_height.replace("px", "") * 2}
              alt={title}
              style={{
                height: logo_height.replace("px", "") + "px",
                width: logo_width.replace("px", "") + "px",
              }}
            />
          ) : (
            <ImageMod
              src={srcDarkmode ? srcDarkmode : logo_darkmode}
              class={"logo-dark hidden dark:inline-block"}
              width={logo_width.replace("px", "") * 2}
              height={logo_height.replace("px", "") * 2}
              alt={title}
              style={{
                height: logo_height.replace("px", "") + "px",
                width: logo_width.replace("px", "") + "px",
              }}
              format="webp"
            />
          )
        )}
      </>
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
