---
import { withBase } from "@/lib/utils/withBase";

interface Props {
  contactLink: string;
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
}

const {
  contactLink,
  title = "LE INVITAMOS A CRECER CON CIHUBS",
  subtitle = "Contáctenos",
  ctaLabel = "CONTÁCTENOS",
} = Astro.props;
---

<section class="bg-gray-50">
  <div class="mx-auto max-w-4xl px-4 py-16 text-center">
    <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#203370] text-white">
      <svg class="h-6 w-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8v8a5 5 0 0 0 10 0V8a5 5 0 0 0-10 0Zm4-3v3h2V5a2 2 0 1 0-4 0v2h2Zm0 0V3m0 16v2m8-8h2m-2-4h2m-2 8h2M5 8H3m2 4H3m2 4H3" />
      </svg>
    </div>
    <h2 class="mb-6 text-3xl font-bold text-[#203370]" style="font-family: 'Poppins', sans-serif; font-weight: 700;">
      {title}
    </h2>
    <p class="mb-8 text-lg text-gray-700" style="font-family: 'Montserrat', sans-serif; font-weight: 400;">
      {subtitle}
    </p>
    <a
      href={withBase(contactLink)}
      class="inline-flex items-center gap-2 rounded-lg bg-[#203370] px-8 py-4 text-center font-bold text-white transition-colors hover:bg-[#2a4289] focus:ring-4 focus:ring-blue-300 focus:outline-none"
      style="font-family: 'Montserrat', sans-serif; font-weight: 700; letter-spacing: 0.0625rem;"
    >
      <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8v8a5 5 0 0 0 10 0V8a5 5 0 0 0-10 0Zm4-3v3h2V5a2 2 0 1 0-4 0v2h2Zm0 0V3m0 16v2m8-8h2m-2-4h2m-2 8h2M5 8H3m2 4H3m2 4H3" />
      </svg>
      {ctaLabel}
    </a>
  </div>
</section>
